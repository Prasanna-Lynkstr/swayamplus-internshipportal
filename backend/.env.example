NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
# swayamplus_internship_v2 is the active dev database for the spec overhaul.
# swayamplus_internship (no suffix) is the pre-overhaul MVP database — kept
# as read-only reference, do not point new work at it. See
# docs/DATABASE_OVERHAUL_AUDIT.md.
DB_NAME=swayamplus_internship_v2
DB_USER=postgres
DB_PASSWORD=postgres

# Sequelize connection pool sizing — tune to your deployment target, don't
# leave at library defaults under real concurrent load.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# File storage driver for resumes + employer verification documents: 'local' or 'r2'.
# 'local' writes to disk under UPLOADS_DIR — fine for a single-instance dev/demo
# environment, but won't survive across instances/deploys. Switch to 'r2' (Cloudflare
# R2, S3-compatible) once you have a bucket — no code changes needed, see
# backend/src/modules/storage/.
STORAGE_DRIVER=local

# Only used when STORAGE_DRIVER=local. Absolute or project-relative path where
# uploaded files are stored.
UPLOADS_DIR=uploads

# Max resume / verification-document upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Only used when STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL files are served from (an r2.dev URL or your own custom domain
# bound to the bucket) — no trailing slash.
R2_PUBLIC_URL=

# AI-generated applicant checklist — see backend/src/modules/checklist/.
# 'heuristic' (default) needs no external dependency. Set to 'anthropic' and
# fill in ANTHROPIC_API_KEY to use Claude for real LLM-derived checklists —
# leaving the key empty silently keeps the heuristic provider even if
# CHECKLIST_PROVIDER=anthropic, same "empty = dev-safe default" pattern as
# SMTP/R2 above.
CHECKLIST_PROVIDER=heuristic
CHECKLIST_MAX_ITEMS=6
ANTHROPIC_API_KEY=
CHECKLIST_LLM_MODEL=claude-haiku-4-5-20251001

# OTP behavior — see backend/src/modules/auth/auth.service.ts
OTP_TTL_MINUTES=10
OTP_REQUEST_LIMIT=5
OTP_VERIFY_ATTEMPT_LIMIT=5

# Pagination defaults — see backend/src/modules/internships/internships.service.ts
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100

ADMIN_EMAIL=admin@swayamplus.gov.in
ADMIN_PASSWORD=change-me-before-seeding

# SMTP — real email delivery for application-status and employer-verification
# notifications (backend/src/modules/notifications/notifications.service.ts).
# Leave SMTP_HOST empty to keep the dev-mode console-log stub. Also gated by
# the "Email notifications" toggle on /admin/employers (platform_settings
# table) — both the env config AND the toggle must be on to actually send.
# Example values for ZeptoMail (works with any standard SMTP provider —
# SES, Mailgun, Postmark, etc. — just swap host/port/credentials):
#   SMTP_HOST=smtp.zeptomail.in
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=emailapikey
#   SMTP_PASSWORD=<your ZeptoMail SMTP token>
#   SMTP_FROM="SWAYAM Plus <no-reply@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
