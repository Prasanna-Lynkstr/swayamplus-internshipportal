NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=swayamplus_internship
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# File storage driver for resumes + employer verification documents: 'local' or 'r2'.
# 'local' writes to disk under UPLOADS_DIR — fine for a single-instance dev/demo
# environment, but won't survive across instances/deploys. Switch to 'r2' (Cloudflare
# R2, S3-compatible) once you have a bucket — no code changes needed, see
# backend/src/modules/storage/.
STORAGE_DRIVER=local

# Only used when STORAGE_DRIVER=local. Absolute or project-relative path where
# uploaded files are stored.
UPLOADS_DIR=uploads

# Only used when STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL files are served from (an r2.dev URL or your own custom domain
# bound to the bucket) — no trailing slash.
R2_PUBLIC_URL=

ADMIN_EMAIL=admin@swayamplus.gov.in
ADMIN_PASSWORD=change-me-before-seeding
